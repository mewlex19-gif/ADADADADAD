-- ==================== CORE ====================
local function isWL(p)
    for _, n in ipairs(S.Whitelist) do if n == p.Name then return true end end
    return false
end

local function isValid(p)
    if p == LP or isWL(p) then return false end
    local ch = p.Character; if not ch then return false end
    local r = ch:FindFirstChild("HumanoidRootPart"); if not r then return false end
    local h = ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health <= 0 then return false end
    if S.TeamCheck and p.Team and LP.Team and p.Team == LP.Team then return false end
    if S.LimitDist and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        if (r.Position - LP.Character.HumanoidRootPart.Position).Magnitude > S.MaxDist then return false end
    end
    return true
end

