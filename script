-- Keybind Helpers
local function encodeKey(key)
    if typeof(key) == "EnumItem" then
        return key.Name
    elseif type(key) == "string" then
        return key:gsub("^Enum%.KeyCode%.", ""):gsub("^Enum%.UserInputType%.", "")
    end
    return "E"
end

local function decodeKey(keyStr, fallback)
    if typeof(keyStr) == "EnumItem" then return keyStr end
    if type(keyStr) == "string" then
        local raw = keyStr:gsub("^Enum%.KeyCode%.", ""):gsub("^Enum%.UserInputType%.", "")
        if raw == "MouseButton2" or raw == "MB2" or raw == "RightClick" then
            return Enum.UserInputType.MouseButton2
        elseif raw == "MouseButton1" or raw == "MB1" or raw == "LeftClick" then
            return Enum.UserInputType.MouseButton1
        elseif Enum.KeyCode[raw] then
            return Enum.KeyCode[raw]
        elseif Enum.UserInputType[raw] then
            return Enum.UserInputType[raw]
        end
    end
    return fallback
end

local function isInputMatch(input, target)
    if not target then return false end
    if typeof(target) == "EnumItem" then
        if target.EnumType == Enum.KeyCode then
            return input.KeyCode == target
        elseif target.EnumType == Enum.UserInputType then
            return input.UserInputType == target
        end
    end
    return input.KeyCode == target
end

