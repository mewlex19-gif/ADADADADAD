-- ══════════════════════════════════════════════════════════════════
local npcFrame=0
local function renderNPCESP()
    if not S.NPCESP then if espActive then destroyAllNPCESP() end; return end
    espActive=true; npcFrame=npcFrame+1; if npcFrame%3~=0 then return end
    local ch=LP.Character; if not ch then return end
    local rt=ch:FindFirstChild("HumanoidRootPart"); if not rt then return end
    local now=tick()
    if now-lastScan>S.NPCScanRate then npcCache=findNPCs(); lastScan=now end
    for _,npc in ipairs(npcCache) do
        if npc and npc.Parent then
            local hrp=npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hm=npc:FindFirstChildOfClass("Humanoid")
                if hm and hm.Health>0 then
                    local d=(hrp.Position-rt.Position).Magnitude
                    if d<=S.NPCMaxDist then
                        local esp=npc:FindFirstChild(NPC_TAG)
                        if not esp then
                            esp=Instance.new("Highlight"); esp.Name=NPC_TAG
                            esp.Adornee=npc; esp.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; esp.Parent=npc
                        end
                        esp.Enabled=true; esp.OutlineColor=S.NPCESPColor; esp.FillColor=S.NPCESPColor
                        esp.OutlineTransparency=0.2; esp.FillTransparency=0.7
                    else
                        local esp=npc:FindFirstChild(NPC_TAG); if esp then esp.Enabled=false end
                    end
                else destroyNPCESP(npc) end
            else destroyNPCESP(npc) end
        end
    end
end
 
