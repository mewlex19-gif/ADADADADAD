local function sF()
    local ch = LP.Character
    if not ch then return end
    local rt = ch:FindFirstChild("HumanoidRootPart")
    if not rt then return end
    pcall(function() rt:FindFirstChild("NBV"):Destroy() end)
    pcall(function() rt:FindFirstChild("NBG"):Destroy() end)
    fBV = Instance.new("BodyVelocity")
    fBV.Name = "NBV"
    fBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    fBV.Velocity = Vector3.new(0, 0, 0)
    fBV.Parent = rt
    fBG = Instance.new("BodyGyro")
    fBG.Name = "NBG"
    fBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    fBG.D = 100
    fBG.P = 10000
    fBG.Parent = rt
    pcall(function() ch:FindFirstChildOfClass("Humanoid").PlatformStand = true end)
    fOn = true
end

RunService.RenderStepped:Connect(function()
    if S.Fly then
        if not fOn then sF() end
        if fBV and fBG then
            local spd = S.FlySpeed * 50
            local dir = Vector3.new(0, 0, 0)
            local ref = S.FlyMode == "Camera" and Cam.CFrame or (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.CFrame or Cam.CFrame)
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + ref.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - ref.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - ref.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + ref.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit end
            fBV.Velocity = dir * spd
            if S.FlyMode == "Camera" then fBG.CFrame = (workspace.CurrentCamera or Cam).CFrame end
        end
    elseif fOn then
        pcall(function()
            if LP.Character then
                local rt = LP.Character:FindFirstChild("HumanoidRootPart")
                if rt then
                    pcall(function() rt:FindFirstChild("NBV"):Destroy() end)
                    pcall(function() rt:FindFirstChild("NBG"):Destroy() end)
                end
                pcall(function() LP.Character:FindFirstChildOfClass("Humanoid").PlatformStand = false end)
            end
        end)
        fOn = false
        fBV = nil
        fBG = nil
    end
end)
