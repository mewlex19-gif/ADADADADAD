                if S.ESPHealth and hm then
                    local hp=math.clamp(hm.Health/math.max(hm.MaxHealth,1),0,1)
                    local hf=hb:FindFirstChild("HF")
                    if hf then
                        hf.Size=UDim2.new(hp,0,1,0)
                        hf.BackgroundColor3=Color3.fromRGB(math.floor(255*(1-hp)),math.floor(255*hp),50)
                    end
                    if ht then
                        ht.Visible=true
                        ht.Text=math.floor(hm.Health).."/"..math.floor(hm.MaxHealth)
                    end
                else
                    if ht then ht.Visible=false end
                end
            end
        end
 
        -- Highlight (box / chams)
        local showHL=S.ESPBox or S.ESPChams
        if showHL then
            local hl=ch:FindFirstChild(ESP_TAG.."HL")
            if not hl then
                pcall(function()
                    hl=Instance.new("Highlight"); hl.Name=ESP_TAG.."HL"
                    hl.Adornee=ch; hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent=ch
                end)
            end
            if hl then
                hl.Enabled=true
                hl.OutlineColor=S.ESPColor
                hl.FillColor=S.ESPColor
                hl.OutlineTransparency=S.ESPBox and 0 or 1
                hl.FillTransparency=S.ESPFilled and 0.5 or (S.ESPChams and 0.6 or 1)
            end
        else
            local hl=ch:FindFirstChild(ESP_TAG.."HL"); if hl then hl.Enabled=false end
        end
    end
end
 
