        local summary, hasData = getPresetSummary(slot)
        statusLbl.Text = summary
        statusLbl.TextColor3 = Color3.fromRGB(90, 225, 165)
    end
end

local function loadPresetSlot(slot)
    local data = nil
    local path = getPresetPath(slot)
    local ok, content = pcall(function() return readfile(path) end)
    if ok and content then
        pcall(function() data = HttpService:JSONDecode(content) end)
    end
    if not data and memoryPresets[slot] then
        data = memoryPresets[slot]
    end

    if not data then
        showToast("❌ Preset Slot " .. slot .. " is empty!", Color3.fromRGB(255, 90, 90))
        return false
    end

    S.ESPBox = data.ESPBox or false; S.ESPName = data.ESPName or false; S.ESPDist = data.ESPDist or false; S.ESPHealth = data.ESPHealth or false; S.ESPFilled = data.ESPFilled or false
    if data.ESPColor then S.ESPColor = Color3.new(data.ESPColor[1], data.ESPColor[2], data.ESPColor[3]) end
    S.TeamCheck = data.TeamCheck or false; S.LimitDist = data.LimitDist or false; S.MaxDist = data.MaxDist or 500
    S.Aimbot = data.Aimbot or false; S.AimKey = decodeKey(data.AimKey, Enum.KeyCode.E); S.AimPart = data.AimPart or "Head"; S.AimSmooth = data.AimSmooth or 0.1
    S.Speed = data.Speed or false; S.SpeedVal = data.SpeedVal or 32; S.NoClip = data.NoClip or false; S.Fly = data.Fly or false; S.FlySpeed = data.FlySpeed or 2; S.FlyMode = data.FlyMode or "Camera"
    S.NPCESP = data.NPCESP or false; S.NPCMaxDist = data.NPCMaxDist or 300
    if data.NPCESPColor then S.NPCESPColor = Color3.new(data.NPCESPColor[1], data.NPCESPColor[2], data.NPCESPColor[3]) end
    S.NPCAimbot = data.NPCAimbot or false; S.NPCAimKey = decodeKey(data.NPCAimKey, Enum.KeyCode.Q); S.NPCAimSmooth = data.NPCAimSmooth or 0.15; S.NPCAimMode = data.NPCAimMode or "Distance"
    S.FOVEnabled = data.FOVEnabled or false; S.FOVValue = data.FOVValue or 70
    S.FOVUpKey = decodeKey(data.FOVUpKey, Enum.KeyCode.PageUp)
    S.FOVDownKey = decodeKey(data.FOVDownKey, Enum.KeyCode.PageDown)
    S.Whitelist = data.Whitelist or {}

    showToast("📂 Loaded Preset Slot " .. slot .. "!", Color3.fromRGB(90, 205, 255))
