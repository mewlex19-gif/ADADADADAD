function panicKill()
    resetAll()
    destroyAllNPCESP()
    for _,p in ipairs(Players:GetPlayers()) do
        local ch=getChar(p); if ch then
            local hl=ch:FindFirstChild(ESP_TAG.."HL"); if hl then hl:Destroy() end
            local hd=getPart(ch,"Head"); if hd then local b=hd:FindFirstChild(ESP_TAG); if b then b:Destroy() end end
