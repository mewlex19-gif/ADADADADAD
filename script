local function teleportToPlayer(player)
    if not player or not player.Character then
        print("[Teleport] Player not found.")
        return
    end
    local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
    if not targetHRP then
        print("[Teleport] Target has no HumanoidRootPart.")
        return
    end
    local LPChar = LP.Character
    if not LPChar then
        print("[Teleport] You have no character.")
        return
    end
    local localHRP = LPChar:FindFirstChild("HumanoidRootPart")
    if not localHRP then
        print("[Teleport] You have no HumanoidRootPart.")
        return
    end
    localHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
    print("[Teleport] Teleported to " .. player.Name)
end

-- ==================== NPC ====================
local NPC_TAG="NyxNPC"
local npcCache={}
local npcFrame=0
local lastScan=0
local scanInt=0.5
local espActive=false

local function findNPCs()
    local r={}
    for _,o in ipairs(WS:GetDescendants()) do
        if o:IsA("Model") then
            local h=o:FindFirstChildOfClass("Humanoid")
            if h and h.Health and h.Health>0 then
                local hrp=o:FindFirstChild("HumanoidRootPart")
                if hrp and not Players:GetPlayerFromCharacter(o) and o~=LP.Character then
                    table.insert(r,o)
                end
            end
        end
    end
    return r
end

local function refreshNPC() npcCache=findNPCs() end
local function destroyNPCESP(m)
    pcall(function()
        local t=m:FindFirstChild(NPC_TAG)
        if t then t:Destroy() end
    end)
end
local function destroyAllNPCESP()
    for _,o in ipairs(WS:GetDescendants()) do
        if o:IsA("Model") then
            destroyNPCESP(o)
        end
    end
    npcCache={}
    espActive=false
end

local function renderNPCESP()
    if not S.NPCESP then
        if espActive then destroyAllNPCESP() end
        return
    end
    espActive=true
    npcFrame=npcFrame+1
    if npcFrame%3~=0 then return end
    local ch=LP.Character
    if not ch then return end
    local rt=ch:FindFirstChild("HumanoidRootPart")
    if not rt then return end
    local pos=rt.Position
    local now=tick()
    if now-lastScan>scanInt then
        refreshNPC()
        lastScan=now
    end
    for _,npc in ipairs(npcCache) do
        if npc and npc.Parent then
            local hrp=npc:FindFirstChild("HumanoidRootPart")
            if hrp then
                local hum=npc:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health and hum.Health>0 then
                    local d=(hrp.Position-pos).Magnitude
                    if d<=S.NPCMaxDist then
                        local esp=npc:FindFirstChild(NPC_TAG)
                        if not esp then
                            esp=Instance.new("Highlight")
                            esp.Name=NPC_TAG
                            esp.Adornee=npc
                            esp.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                            esp.Parent=npc
                        end
                        esp.Enabled=true
                        esp.OutlineColor=S.NPCESPColor or C.npcColor
                        esp.FillColor=S.NPCESPColor or C.npcColor
                        esp.OutlineTransparency=0.2
                        esp.FillTransparency=0.7
                    else
                        local esp=npc:FindFirstChild(NPC_TAG)
                        if esp then esp.Enabled=false end
                    end
                else
                    destroyNPCESP(npc)
                end
            else
                destroyNPCESP(npc)
            end
        end
    end
end

