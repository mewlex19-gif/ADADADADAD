local function loadPreset(slot)
    local data=memPresets[slot]
    if not data then
        local ok,content=pcall(function() return readfile(ConfigFolder.."/preset_"..slot..".json") end)
        if ok and content then pcall(function() data=Http:JSONDecode(content) end) end
    end
    if not data then showToast("❌ Slot "..slot.." is empty",C.red); return false end
 
    for _,key in ipairs({"ESPEnabled","ESPBox","ESPName","ESPDist","ESPHealth","ESPFilled",
        "ESPSkeleton","ESPTracers","ESPChams","TeamCheck","LimitDist","LimitDist","MaxDist",
        "FOVEnabled","FOVValue","Aimbot","AimPart","AimSmooth","AimFOV","VisibleOnly",
        "SilentAim","Prediction","Speed","SpeedVal","JumpPower","JumpVal","Fly","FlySpeed",
        "FlyMode","NoClip","InfJump","BunnyHop","LowGrav","GravVal",
        "KillAura","KillAuraMode","KillAuraReach","HitboxExpand","HitboxSize",
        "AntiAim","AntiAimMode","AntiAimSpeed",
        "NPCESP","NPCMaxDist","NPCAimbot","NPCAimSmooth","NPCAimMode",
        "NPCKillAura","NPCKillAuraReach"}) do
        if data[key]~=nil then S[key]=data[key] end
    end
    if data.ESPColor then S.ESPColor=Color3.new(table.unpack(data.ESPColor)) end
    if data.NPCESPColor then S.NPCESPColor=Color3.new(table.unpack(data.NPCESPColor)) end
    if data.AimKey then S.AimKey=decodeKey(data.AimKey,Enum.KeyCode.E) end
    if data.NPCAimKey then S.NPCAimKey=decodeKey(data.NPCAimKey,Enum.KeyCode.Q) end
    if data.Whitelist then S.Whitelist=data.Whitelist end
 
    syncUI()
    showToast("📂 Loaded Slot "..slot,C.skyBlue)
    return true
end
 
