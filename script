--  KILL AURA
-- ══════════════════════════════════════════════════════════════════
local function runKillAura()
    if not S.KillAura then return end
    local now=tick()
    if now-kaLastFire<S.KillAuraDelay then return end
    local myChar=LP.Character; local myRt=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRt then return end
 
    local targets={}
    for _,p in ipairs(Players:GetPlayers()) do
        if isValidPlayer(p) then
            local ch=getChar(p); local rt=ch and getPart(ch,"HumanoidRootPart")
            if rt and (rt.Position-myRt.Position).Magnitude<=S.KillAuraReach then
                table.insert(targets,p)
                if S.KillAuraMode=="Closest" then break end
            end
        end
    end
 
    for _,p in ipairs(targets) do
        pcall(function()
            local ch=getChar(p); local hm=getHum(p)
            if hm then hm.Health=0 end
        end)
    end
    kaLastFire=now
end
 
local function runNPCKillAura()
    if not S.NPCKillAura then return end
    local now=tick()
    if now-npcKaLastFire<0.1 then return end
    local myChar=LP.Character; local myRt=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRt then return end
    for _,npc in ipairs(npcCache) do
        if npc and npc.Parent then
            local hrp=npc:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position-myRt.Position).Magnitude<=S.NPCKillAuraReach then
                local hm=npc:FindFirstChildOfClass("Humanoid")
                pcall(function() if hm then hm.Health=0 end end)
            end
        end
    end
    npcKaLastFire=now
end
 
