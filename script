        else
            local hl = ch:FindFirstChild(ESP_TAG .. "HL")
            if hl then hl.Enabled = false end
        end
    end
end

-- ==================== HOLD AIMBOT ====================
local aimTarget = nil
local aimHeld = false
local function getAimTarget()
    local best, bv = nil, math.huge
    local ch = LP.Character
    if not ch then return nil end
    local rt = ch:FindFirstChild("HumanoidRootPart")
    if not rt then return nil end
    local c = workspace.CurrentCamera or Cam
    if not c then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        if isValid(p) and p.Character then
            local pt = p.Character:FindFirstChild(S.AimPart) or p.Character:FindFirstChild("Head")
            if pt then
                local sp, os = c:WorldToScreenPoint(pt.Position)
                if os then
                    local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(c.ViewportSize.X / 2, c.ViewportSize.Y / 2)).Magnitude
                    if d < bv then
                        bv = d
                        best = p
                    end
                end
            end
        end
    end
    return best
end

local function getNPCAimTarget()
    local best, bv = nil, math.huge
    local ch = LP.Character
    if not ch then return nil end
    local rt = ch:FindFirstChild("HumanoidRootPart")
    if not rt then return nil end
    local c = workspace.CurrentCamera or Cam
    if not c then return nil end
    for _, npc in ipairs(npcCache) do
        if npc and npc.Parent then
            local pt = npc:FindFirstChild("Head") or npc:FindFirstChild("HumanoidRootPart")
            if pt then
                local sp, os = c:WorldToScreenPoint(pt.Position)
                if os then
                    local d
                    if S.NPCAimMode == "Distance" then
                        d = (pt.Position - rt.Position).Magnitude
                    else
                        d = (Vector2.new(sp.X, sp.Y) - Vector2.new(c.ViewportSize.X / 2, c.ViewportSize.Y / 2)).Magnitude
                    end
                    if d < bv then
                        bv = d
                        best = npc
                    end
                end
            end
        end
    end
    return best
end

