local function lerp(a,b,t) return a+(b-a)*t end
 
local function getChar(p) return p and p.Character end
local function getHum(p) local c=getChar(p); return c and c:FindFirstChildOfClass("Humanoid") end
local function getPart(char,name) return char and char:FindFirstChild(name) end
 
local function isValidPlayer(p)
    if p==LP then return false end
    for _,n in ipairs(S.Whitelist) do if n==p.Name then return false end end
    local ch=getChar(p); if not ch then return false end
    local rt=getPart(ch,"HumanoidRootPart"); if not rt then return false end
    local h=ch:FindFirstChildOfClass("Humanoid"); if not h or h.Health<=0 then return false end
    if S.TeamCheck and p.Team and LP.Team and p.Team==LP.Team then return false end
    if S.LimitDist then
        local mc=getChar(LP); local mr=mc and getPart(mc,"HumanoidRootPart")
        if mr and (rt.Position-mr.Position).Magnitude>S.MaxDist then return false end
    end
    return true
end
 
local function isVisible(part)
    if not S.VisibleOnly then return true end
    local c=getChar(LP); if not c then return true end
    local rt=getPart(c,"HumanoidRootPart"); if not rt then return true end
    local ray=workspace:Raycast(rt.Position,(part.Position-rt.Position).Unit*999,
        RaycastParams.new())
    if not ray then return true end
    local hit=ray.Instance
    if not hit then return true end
    local m=hit:FindFirstAncestorOfClass("Model")
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character and m==p.Character then return true end
    end
    return false
end
 
