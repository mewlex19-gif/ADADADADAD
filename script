--  AIMBOT TARGETS
-- ══════════════════════════════════════════════════════════════════
local function getPlayerTarget()
    local best,bestD=nil,math.huge
    local c=workspace.CurrentCamera or Cam; if not c then return end
    local cx,cy=c.ViewportSize.X/2,c.ViewportSize.Y/2
    for _,p in ipairs(Players:GetPlayers()) do
        if not isValidPlayer(p) then continue end
        local ch=getChar(p); if not ch then continue end
        local pt=getPart(ch,S.AimPart) or getPart(ch,"Head"); if not pt then continue end
        if S.VisibleOnly and not isVisible(pt) then continue end
        local pred=pt.Position
        local hrp=getPart(ch,"HumanoidRootPart")
        if hrp and S.Prediction>0 then pred=pred+hrp.AssemblyLinearVelocity*S.Prediction end
        local sp,onS=c:WorldToViewportPoint(pred)
        if not onS then continue end
        local d=(Vector2.new(sp.X,sp.Y)-Vector2.new(cx,cy)).Magnitude
        if d<S.AimFOV and d<bestD then bestD=d; best=p end
    end
    return best
end
 
local function getNPCTarget()
    local best,bestD=nil,math.huge
    local c=workspace.CurrentCamera or Cam; if not c then return end
    local cx,cy=c.ViewportSize.X/2,c.ViewportSize.Y/2
    local myChar=LP.Character; local myRt=myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _,npc in ipairs(npcCache) do
        if not npc or not npc.Parent then continue end
        local pt=npc:FindFirstChild("Head") or npc:FindFirstChild("HumanoidRootPart")
        if not pt then continue end
        local sp,onS=c:WorldToViewportPoint(pt.Position)
        if not onS then continue end
        local d
        if S.NPCAimMode=="Distance" then
            d=myRt and (pt.Position-myRt.Position).Magnitude or math.huge
        else
            d=(Vector2.new(sp.X,sp.Y)-Vector2.new(cx,cy)).Magnitude
        end
        if d<bestD then bestD=d; best=npc end
    end
    return best
end
 
