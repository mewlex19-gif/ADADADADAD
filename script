--  HITBOX EXPANDER
-- ══════════════════════════════════════════════════════════════════
local function applyHitboxes()
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LP then
            local ch=getChar(p)
            if ch then
                local head=getPart(ch,"Head")
                if head then
                    local existing=ch:FindFirstChild("NyxHitbox")
                    if S.HitboxExpand and not existing then
                        local bp=Instance.new("Part")
                        bp.Name="NyxHitbox"; bp.Size=Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize)
                        bp.Transparency=1; bp.CanCollide=false; bp.Anchored=false; bp.Parent=ch
                        local weld=Instance.new("WeldConstraint")
                        weld.Part0=head; weld.Part1=bp; weld.Parent=bp
                        hitboxInstances[ch]=bp
                    elseif not S.HitboxExpand and existing then
                        existing:Destroy(); hitboxInstances[ch]=nil
                    elseif existing and S.HitboxExpand then
                        existing.Size=Vector3.new(S.HitboxSize,S.HitboxSize,S.HitboxSize)
                    end
                end
            end
        end
    end
end
 
