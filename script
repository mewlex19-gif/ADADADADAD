local ConfigFolder = "NyxHub_Configs"
local function getPresetPath(slot) return ConfigFolder .. "/preset_" .. tostring(slot) .. ".json" end
local memoryPresets = {}

local function syncUI()
    for key, setFunc in pairs(UIControls.toggles) do
        if S[key] ~= nil then
            pcall(function() setFunc(S[key], false) end)
        end
    end

    for key, setFunc in pairs(UIControls.sliders) do
        if S[key] ~= nil then
            pcall(function() setFunc(S[key]) end)
        end
    end

    for key, setFunc in pairs(UIControls.colorPickers) do
        if S[key] ~= nil then
            pcall(function() setFunc(S[key]) end)
        end
    end

    for key, setFunc in pairs(UIControls.keybinds) do
        if S[key] ~= nil then
            pcall(function() setFunc(S[key]) end)
        end
    end

    pcall(applyFOV)

    pcall(function()
        if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then
            if S.Speed then
                LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = S.SpeedVal
            else
                LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = 16
            end
        end
    end)

    if not S.Fly and fOn then
        pcall(function()
            if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                local rt = LP.Character.HumanoidRootPart
                pcall(function() rt:FindFirstChild("NBV"):Destroy() end)
                pcall(function() rt:FindFirstChild("NBG"):Destroy() end)
            end
            pcall(function() LP.Character:FindFirstChildOfClass("Humanoid").PlatformStand = false end)
        end)
        fOn = false
        fBV = nil
        fBG = nil
    end

    if not S.NPCESP then
        pcall(destroyAllNPCESP)
    end
end

local function getPresetSummary(slot)
    local data = nil
    local path = getPresetPath(slot)
    local ok, content = pcall(function() return readfile(path) end)
    if ok and content then
        pcall(function() data = HttpService:JSONDecode(content) end)
    end
    if not data and memoryPresets[slot] then
        data = memoryPresets[slot]
    end

    if not data then return "Empty Slot", false end

    local active = {}
    if data.ESPBox or data.ESPName then table.insert(active, "ESP") end
    if data.Aimbot then table.insert(active, "Aimbot") end
    if data.Fly then table.insert(active, "Fly") end
    if data.Speed then table.insert(active, "Speed") end
    if data.NoClip then table.insert(active, "NoClip") end
    if data.FOVEnabled then table.insert(active, "FOV") end
    if #active == 0 then return "Saved (All Off)", true end
    return "Saved: " .. table.concat(active, ", "), true
end

