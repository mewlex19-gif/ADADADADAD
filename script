local skeletonLines = {}  -- [player] = {lines}
 
local function clearSkeleton(p)
    if skeletonLines[p] then
        for _,l in ipairs(skeletonLines[p]) do pcall(function() l:Remove() end) end
        skeletonLines[p]=nil
    end
end
 
local function updateSkeletons()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LP then continue end
        local ch=getChar(p)
        if not ch or not S.ESPSkeleton or not S.ESPEnabled then
            clearSkeleton(p); continue
        end
        if not skeletonLines[p] then
            skeletonLines[p]={}
            if Drawing then
                for i=1,#BONES do
                    local l=Drawing.new("Line")
                    l.Visible=false; l.Thickness=1.5; l.ZIndex=5; l.Color=S.ESPColor
                    skeletonLines[p][i]=l
                end
            end
        end
        for i,pair in ipairs(BONES) do
            local la=ch:FindFirstChild(pair[1]); local lb=ch:FindFirstChild(pair[2])
            local line=skeletonLines[p] and skeletonLines[p][i]
            if not line then continue end
            if la and lb then
                local sa,onA=Cam:WorldToViewportPoint(la.Position)
                local sb,onB=Cam:WorldToViewportPoint(lb.Position)
                line.Visible=onA and onB and S.ESPEnabled and S.ESPSkeleton
                line.From=Vector2.new(sa.X,sa.Y); line.To=Vector2.new(sb.X,sb.Y)
                line.Color=S.ESPColor
            else
                line.Visible=false
            end
        end
    end
end
 
