local ESP_TAG = "NyxESP"
local function updatePlayerESP()
    local any = S.ESPBox or S.ESPName or S.ESPDist or S.ESPHealth
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local ch = p.Character
        if not any then
            if ch then
                local h = ch:FindFirstChild("Head")
                if h then
                    local o = h:FindFirstChild(ESP_TAG)
                    if o then o:Destroy() end
                end
                local hl = ch:FindFirstChild(ESP_TAG .. "HL")
                if hl then hl:Destroy() end
            end
            continue
        end
        if not ch then continue end
        local hd = ch:FindFirstChild("Head")
        local rt = ch:FindFirstChild("HumanoidRootPart")
        local hm = ch:FindFirstChildOfClass("Humanoid")
        if not isValid(p) or not hd or not rt or not hm then
            if hd then
                local b = hd:FindFirstChild(ESP_TAG)
                if b then b.Enabled = false end
            end
            local hl = ch:FindFirstChild(ESP_TAG .. "HL")
            if hl then hl.Enabled = false end
            continue
        end
        local bb = hd:FindFirstChild(ESP_TAG)
        if not bb then
            bb = Instance.new("BillboardGui")
            bb.Name = ESP_TAG
            bb.Size = UDim2.new(0, 200, 0, 50)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.LightInfluence = 0
            bb.Parent = hd
            local nl = Instance.new("TextLabel")
            nl.Name = "N"
            nl.BackgroundTransparency = 1
            nl.Size = UDim2.new(1, 0, 0, 16)
            nl.Font = Enum.Font.GothamBold
            nl.TextColor3 = C.skyBlue
            nl.TextSize = 13
            nl.TextStrokeTransparency = 0.2
            nl.TextStrokeColor3 = Color3.new(0, 0, 0)
            nl.Text = p.Name
            nl.Parent = bb
            local dl = Instance.new("TextLabel")
            dl.Name = "D"
            dl.BackgroundTransparency = 1
            dl.Size = UDim2.new(1, 0, 0, 14)
            dl.Position = UDim2.new(0, 0, 0, 16)
            dl.Font = Enum.Font.Gotham
            dl.TextColor3 = Color3.fromRGB(200, 220, 255)
            dl.TextSize = 11
            dl.TextStrokeTransparency = 0.3
            dl.TextStrokeColor3 = Color3.new(0, 0, 0)
            dl.Parent = bb
            local hb = Instance.new("Frame")
            hb.Name = "HB"
            hb.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            hb.BackgroundTransparency = 0.2
            hb.BorderSizePixel = 0
            hb.Size = UDim2.new(0.55, 0, 0, 5)
            hb.Position = UDim2.new(0.225, 0, 0, 33)
            hb.Parent = bb
            local hf = Instance.new("Frame")
            hf.Name = "HF"
            hf.BackgroundColor3 = C.green
            hf.BorderSizePixel = 0
            hf.Size = UDim2.new(1, 0, 1, 0)
            hf.Parent = hb
        end
        local show = S.ESPName or S.ESPDist or S.ESPHealth
        bb.Enabled = show
        if show then
            local nl = bb:FindFirstChild("N")
            if nl then
                nl.Visible = S.ESPName
                nl.TextColor3 = S.ESPColor or C.skyBlue
                nl.Text = p.Name
            end
            local dl = bb:FindFirstChild("D")
            if dl then
                if S.ESPDist and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                    local d = math.floor((rt.Position - LP.Character.HumanoidRootPart.Position).Magnitude)
                    dl.Text = "[" .. d .. "m]"
                    dl.Visible = true
                else
                    dl.Visible = false
                end
            end
            local hb = bb:FindFirstChild("HB")
            if hb then
                hb.Visible = S.ESPHealth
                if S.ESPHealth then
                    local hp = math.clamp(hm.Health / hm.MaxHealth, 0, 1)
