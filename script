-- ==================== FOV CHANGER ====================
local function updateFOV()
    local c = workspace.CurrentCamera or Cam
    if not c then return end
    if S.FOVEnabled then
        c.FieldOfView = S.FOVValue
    else
        c.FieldOfView = 70
    end
end

local function startFOVLoop()
    pcall(function() RunService:UnbindFromRenderStep("NyxHub_FOV") end)
    pcall(function()
        RunService:BindToRenderStep("NyxHub_FOV", Enum.RenderPriority.Last.Value, updateFOV)
    end)
    updateFOV()
end

local function stopFOVLoop()
    pcall(function() RunService:UnbindFromRenderStep("NyxHub_FOV") end)
    local c = workspace.CurrentCamera or Cam
    if c then c.FieldOfView = 70 end
end

local function applyFOV()
    if S.FOVEnabled then
        startFOVLoop()
    else
        stopFOVLoop()
    end
end

local function changeFOV(amount)
    if not S.FOVEnabled then return end
    S.FOVValue = math.clamp(S.FOVValue + amount, 1, 120)
    updateFOV()
    if UIControls and UIControls.sliders and UIControls.sliders["FOVValue"] then
        UIControls.sliders["FOVValue"](S.FOVValue)
    end
end

UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if isInputMatch(i, S.FOVUpKey) then
        changeFOV(5)
    elseif isInputMatch(i, S.FOVDownKey) then
        changeFOV(-5)
    end
end)

