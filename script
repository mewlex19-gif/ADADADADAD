--  KEYBIND HELPERS
-- ══════════════════════════════════════════════════════════════════
local function encodeKey(k)
    if typeof(k)=="EnumItem" then return k.Name end
    return tostring(k or "None")
end
 
local function decodeKey(s, fb)
    if typeof(s)=="EnumItem" then return s end
    if type(s)=="string" then
        local r = s:gsub("^Enum%.KeyCode%.",""):gsub("^Enum%.UserInputType%.","")
        if r=="MouseButton2" then return Enum.UserInputType.MouseButton2
        elseif r=="MouseButton1" then return Enum.UserInputType.MouseButton1
        elseif Enum.KeyCode[r] then return Enum.KeyCode[r]
        elseif Enum.UserInputType[r] then return Enum.UserInputType[r] end
    end
    return fb
end
 
local function isMatch(inp, target)
    if not target then return false end
    if typeof(target)=="EnumItem" then
        if target.EnumType==Enum.KeyCode then return inp.KeyCode==target end
        if target.EnumType==Enum.UserInputType then return inp.UserInputType==target end
    end
    return inp.KeyCode==target
end
 
local function keyName(k)
    if typeof(k)=="EnumItem" then
        if k==Enum.UserInputType.MouseButton2 then return "MB2" end
        if k==Enum.UserInputType.MouseButton1 then return "MB1" end
        return k.Name
    end
    return tostring(k or "?")
end
 
