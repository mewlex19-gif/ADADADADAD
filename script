--  MAIN RENDER LOOP
-- ══════════════════════════════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    local c=workspace.CurrentCamera or Cam; if not c then return end
 
    -- Aimbot
    if aimHeld and S.Aimbot then
        if not aimTarget or not isValidPlayer(aimTarget) then aimTarget=getPlayerTarget() end
        if aimTarget and getChar(aimTarget) then
            local ch=getChar(aimTarget)
            local pt=getPart(ch,S.AimPart) or getPart(ch,"Head")
            if pt then
                local pred=pt.Position
                local hrp=getPart(ch,"HumanoidRootPart")
                if hrp and S.Prediction>0 then pred=pred+hrp.AssemblyLinearVelocity*S.Prediction end
                local sm=math.clamp(1-S.AimSmooth,0.01,1)
                if S.SilentAim then
                    -- silent aim: store target for external use; camera untouched
                else
                    c.CFrame=c.CFrame:Lerp(CFrame.new(c.CFrame.Position,pred),sm)
                end
            end
        end
    end
 
    -- NPC Aimbot
    if npcAimHeld and S.NPCAimbot then
        if not npcAimTarget or not npcAimTarget.Parent then npcAimTarget=getNPCTarget() end
        if npcAimTarget and npcAimTarget.Parent then
            local pt=npcAimTarget:FindFirstChild("Head") or npcAimTarget:FindFirstChild("HumanoidRootPart")
            if pt then
                local sm=math.clamp(1-S.NPCAimSmooth,0.01,1)
                c.CFrame=c.CFrame:Lerp(CFrame.new(c.CFrame.Position,pt.Position),sm)
            end
        end
    end
 
    -- FOV Circle
    if fovCircle then
        fovCircle.Visible=S.Aimbot and S.ShowFOVCircle
        fovCircle.Radius=S.AimFOV
        fovCircle.Color=S.ESPColor
        fovCircle.Position=Vector2.new(c.ViewportSize.X/2,c.ViewportSize.Y/2)
    end
 
    updatePlayerESP()
    renderNPCESP()
    updateSkeletons()
    updateTracers()
 
    -- Fly
    if S.Fly then
        if not fOn then startFly() end
        if fBV and fBG then
            local spd=S.FlySpeed*50; local dir=Vector3.zero
            local ref=(S.FlyMode=="Camera") and c.CFrame or
                (LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") and LP.Character.HumanoidRootPart.CFrame or c.CFrame)
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir=dir+ref.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir=dir-ref.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir=dir-ref.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir=dir+ref.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.yAxis end
            if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir=dir-Vector3.yAxis end
            if dir.Magnitude>0 then dir=dir.Unit end
            fBV.Velocity=dir*spd
            if S.FlyMode=="Camera" then fBG.CFrame=c.CFrame end
        end
    elseif fOn then stopFly() end
end)
 
