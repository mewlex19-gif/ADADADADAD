local function build_configs(parent)
    local frame = new("Frame", { Size=UDim2.fromScale(1,1), BackgroundTransparency=1 }, parent)

    local col0 = make_col(frame, 8, 390)
    local _, cfg_body = make_panel(col0, "Config Manager", 0, 390)

    -- Config name input
    local name_box = new("TextBox", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = theme.panel,
        Text = "",
        PlaceholderText = "Config name...",
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = theme.text_bright,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
    }, cfg_body)
    new("UICorner", { CornerRadius = UDim.new(0, 4) }, name_box)
    new("UIStroke", { Color = theme.border, Thickness=1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, name_box)
    new("UIPadding", { PaddingLeft = UDim.new(0,8) }, name_box)

    -- Build a combined cfg for save/load
    local function combined_cfg()
        return { aim = AimbotCfg, esp = EspCfg, wepon = WeponCfg }
    end

    local function make_action_btn(label_text, parent_frame, callback)
        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundColor3 = theme.accent_dim,
            Text = label_text,
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            TextColor3 = Color3.fromRGB(255,255,255),
            BorderSizePixel = 0,
            AutoButtonColor = false,
        }, parent_frame)
        new("UICorner", { CornerRadius = UDim.new(0, 4) }, btn)
        btn.MouseButton1Click:Connect(callback)
        hover_button(btn, theme.accent_dim, theme.accent)
        return btn
    end

    make_action_btn("Save Config", cfg_body, function()
        local name = name_box.Text ~= "" and name_box.Text or "default"
        Config.save(combined_cfg(), name)
    end)
    make_action_btn("Load Config", cfg_body, function()
        local name = name_box.Text ~= "" and name_box.Text or "default"
        Config.load(combined_cfg(), name)
    end)
    make_action_btn("Delete Config", cfg_body, function()
        local name = name_box.Text ~= "" and name_box.Text or "default"
        Config.delete(name)
    end)

    -- Presets
    local _, pre_body = make_panel(col0, "Presets", 0, 390)
    for _, preset_name in ipairs(Config.preset_names()) do
        make_action_btn(preset_name, pre_body, function()
            Config.apply_preset(combined_cfg(), preset_name)
        end)
    end

    table.insert(tab_frames, frame)
end

