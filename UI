-- ─── UTIL ─────────────────────────────────────────────────────────────────────
local function new(class, props, parent)
    local inst = Instance.new(class)
    for k, v in pairs(props) do
        inst[k] = v
    end
    if parent then inst.Parent = parent end
    return inst
end

local function tween(inst, props, t, style, dir)
    TweenService:Create(inst,
        TweenInfo.new(t or 0.12, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
        props):Play()
end

local function hover_button(btn, idle_color, hover_color)
    btn.MouseEnter:Connect(function()  tween(btn, {BackgroundColor3 = hover_color}) end)
    btn.MouseLeave:Connect(function()  tween(btn, {BackgroundColor3 = idle_color})  end)
end

