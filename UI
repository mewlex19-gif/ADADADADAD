local function make_panel(parent, title, pos_y, width)
    local panel = new("Frame", {
        Size             = UDim2.new(0, width or 380, 0, 32),
        Position         = UDim2.fromOffset(0, pos_y),
        BackgroundColor3 = theme.panel,
        BorderSizePixel  = 0,
        ClipsDescendants = true,
        AutomaticSize    = Enum.AutomaticSize.Y,
    }, parent)
    new("UICorner", { CornerRadius = UDim.new(0, 6) }, panel)
    new("UIStroke", { Color = theme.border, Thickness = 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, panel)

    new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 28),
        Position = UDim2.fromOffset(14, 0),
        BackgroundTransparency = 1,
        Text = title:upper(),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, panel)

    local divider = new("Frame", {
        Size = UDim2.new(1, -20, 0, 1),
        Position = UDim2.fromOffset(10, 28),
        BackgroundColor3 = theme.border,
        BorderSizePixel  = 0,
    }, panel)

    local body = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.fromOffset(0, 30),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, panel)
    new("UIListLayout", { Padding = UDim.new(0, 0) }, body)
    new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 8) }, body)

    return panel, body
end

local function make_checkbox(parent, label, value_ref, key, color)
    color = color or theme.accent
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundTransparency = 1,
    }, parent)

    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -28, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local box = new("TextButton", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(1, -16, 0.5, -8),
        BackgroundColor3 = value_ref[key] and color or theme.border,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(0, 4) }, box)
    new("UIStroke", { Color = theme.border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)

    local check = new("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "✓",
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextColor3 = Color3.fromRGB(255,255,255),
        Visible = value_ref[key],
    }, box)

    box.MouseButton1Click:Connect(function()
        value_ref[key] = not value_ref[key]
        local on = value_ref[key]
        tween(box, { BackgroundColor3 = on and color or theme.border })
        check.Visible = on
        tween(lbl, { TextColor3 = on and theme.text_bright or theme.text })
    end)

    return row
end

local function make_slider(parent, label, value_ref, key, min, max, fmt)
    fmt = fmt or "%.0f"
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
    }, parent)

    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local val_lbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        Position = UDim2.fromOffset(0, 0),
        BackgroundTransparency = 1,
        Text = string.format(fmt, value_ref[key]),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = theme.accent,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = new("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.fromOffset(0, 24),
        BackgroundColor3 = theme.border,
        BorderSizePixel  = 0,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

    local pct = math.clamp((value_ref[key] - min) / (max - min), 0, 1)
    local fill = new("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = theme.accent,
        BorderSizePixel  = 0,
    }, track)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local thumb = new("Frame", {
        Size = UDim2.fromOffset(10, 10),
        Position = UDim2.new(pct, -5, 0.5, -5),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel  = 0,
    }, track)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, thumb)

    local dragging_slider = false
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging_slider = true
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging_slider = false
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if not dragging_slider then return end
        if i.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local track_abs = track.AbsolutePosition
        local track_sz  = track.AbsoluteSize
        local rel = math.clamp((i.Position.X - track_abs.X) / track_sz.X, 0, 1)
        local new_val = min + (max - min) * rel
        if type(value_ref[key]) == "number" and math.floor(min) == min and math.floor(max) == max then
            new_val = math.floor(new_val + 0.5)
        end
        value_ref[key]  = new_val
        fill.Size        = UDim2.new(rel, 0, 1, 0)
        thumb.Position   = UDim2.new(rel, -5, 0.5, -5)
        val_lbl.Text     = string.format(fmt, new_val)
    end)

    return row
end

local function make_dropdown(parent, label, value_ref, key, options)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        ZIndex = 10,
    }, parent)

    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        Text = label,
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = theme.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, row)

    local selected = value_ref[key]
    local drop_btn = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.fromOffset(0, 20),
        BackgroundColor3 = theme.panel,
        Text = selected,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextColor3 = theme.text_bright,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        ZIndex = 10,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(0, 4) }, drop_btn)
    new("UIStroke", { Color = theme.border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, drop_btn)

    local dropdown = new("Frame", {
        Size = UDim2.new(1, 0, 0, #options * 22),
        Position = UDim2.fromOffset(0, 44),
        BackgroundColor3 = Color3.fromRGB(28, 28, 34),
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 20,
    }, row)
    new("UICorner", { CornerRadius = UDim.new(0, 4) }, dropdown)
    new("UIStroke", { Color = theme.border, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, dropdown)
    new("UIListLayout", {}, dropdown)

    for _, opt in ipairs(options) do
        local opt_btn = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 22),
            BackgroundColor3 = Color3.fromRGB(28,28,34),
            Text = opt,
            Font = Enum.Font.Gotham,
            TextSize = 12,
            TextColor3 = theme.text,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            ZIndex = 20,
        }, dropdown)
        opt_btn.MouseButton1Click:Connect(function()
            value_ref[key] = opt
            drop_btn.Text  = opt
            dropdown.Visible = false
        end)
        hover_button(opt_btn, Color3.fromRGB(28,28,34), theme.tab_active)
    end

    drop_btn.MouseButton1Click:Connect(function()
        dropdown.Visible = not dropdown.Visible
    end)

    return row
end

