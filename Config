-- Config.lua | LuaU | Roblox Executor
-- Config system: save/load settings to executor writefile/readfile, presets, hotkey binds

local HttpService = game:GetService("HttpService")

-- ─── CONFIG SYSTEM ────────────────────────────────────────────────────────────
local Config = {}
Config.__index = Config

-- Default config path — executors write to their own workspace folder
local CONFIG_DIR = "matcha_configs/"
local EXT        = ".json"

-- ─── FILE I/O WRAPPERS ────────────────────────────────────────────────────────
-- Handles executor differences: syn.filesystem, readfile/writefile, etc.
local fs = {}

function fs.write(path, data)
    if writefile then
        writefile(path, data)
    elseif syn and syn.writefile then
        syn.writefile(path, data)
    end
end

function fs.read(path)
    if readfile then
        return readfile(path)
    elseif syn and syn.readfile then
        return syn.readfile(path)
    end
    return nil
end

function fs.exists(path)
    if isfile then return isfile(path) end
    if syn and syn.isfile then return syn.isfile(path) end
    -- fallback: try reading
    local ok, _ = pcall(fs.read, path)
    return ok
end

function fs.mkdir(path)
    if isfolder and not isfolder(path) then
        if makefolder then makefolder(path) end
    elseif syn and syn.isfolder and not syn.isfolder(path) then
        if syn.makefolder then syn.makefolder(path) end
    else
        -- executor may auto-create on writefile
        pcall(makefolder or function() end, path)
    end
end

-- ─── SERIALIZATION ────────────────────────────────────────────────────────────
-- Convert Color3 / Enum values to serializable form and back
local function serialize_value(v)
    if typeof(v) == "Color3" then
        return { __type = "Color3", r = v.R, g = v.G, b = v.B }
    elseif typeof(v) == "EnumItem" then
        return { __type = "EnumItem", enum = tostring(v.EnumType), name = v.Name }
    elseif type(v) == "table" then
        local t = {}
        for k, val in pairs(v) do
            t[k] = serialize_value(val)
        end
        return t
    end
    return v
end

local function deserialize_value(v)
    if type(v) == "table" then
        if v.__type == "Color3" then
            return Color3.new(v.r, v.g, v.b)
        elseif v.__type == "EnumItem" then
            local ok, result = pcall(function()
                return Enum[v.enum][v.name]
            end)
            return ok and result or Enum.KeyCode.Unknown
        else
            local t = {}
            for k, val in pairs(v) do
                t[k] = deserialize_value(val)
            end
            return t
        end
    end
    return v
end

-- Deep merge: apply saved values onto existing cfg table (preserves keys not in save)
local function deep_merge(target, source)
    for k, v in pairs(source) do
        if type(v) == "table" and type(target[k]) == "table" then
            deep_merge(target[k], v)
        else
            target[k] = v
        end
    end
end

